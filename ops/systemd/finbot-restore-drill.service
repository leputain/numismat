[Unit]
Description=Restore and verify the latest Finbot encrypted backup
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=finbot
WorkingDirectory=/opt/finbot
EnvironmentFile=-/etc/finbot/backup.env
UMask=0077
ExecStart=/usr/bin/make --directory=/opt/finbot restore-drill
TimeoutStartSec=6h
NoNewPrivileges=true
