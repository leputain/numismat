# syntax=docker/dockerfile:1.7

FROM node:22.22.2-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS web-build

WORKDIR /web
RUN chown node:node /web
RUN npm install --global npm@10.9.7 \
    && test "$(npm --version)" = "10.9.7"
COPY --chown=node:node web/package.json web/package-lock.json ./
USER node
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 \
    npm ci
COPY --chown=node:node web/ ./
RUN npm run build \
    && ! find dist -type f -name "*.map" -print -quit | grep -q . \
    && grep -Fq 'src="https://telegram.org/js/telegram-web-app.js?63"' dist/index.html

FROM ghcr.io/nginx/nginx-unprivileged:1.30.4-alpine3.24@sha256:44e36330f74d4f3a1d4e222acca9e23b401fb87811a7597024502bb759c4dd49

LABEL org.opencontainers.image.title="Numismat Mini App edge" \
      org.opencontainers.image.description="Immutable same-origin Mini App and API edge"

USER root
RUN mkdir -p /etc/nginx/numismat
COPY deploy/web/nginx.conf /etc/nginx/nginx.conf
COPY deploy/web/security-headers.conf /etc/nginx/numismat/security-headers.conf
COPY deploy/web/site.conf.template /etc/nginx/numismat/site.conf.template
COPY deploy/web/entrypoint.sh /usr/local/bin/numismat-web-entrypoint
COPY --from=web-build --chown=101:101 /web/dist/ /usr/share/nginx/html/
RUN chmod 0444 \
        /etc/nginx/nginx.conf \
        /etc/nginx/numismat/security-headers.conf \
        /etc/nginx/numismat/site.conf.template \
    && chmod 0555 /usr/local/bin/numismat-web-entrypoint \
    && find /usr/share/nginx/html -type d -exec chmod 0555 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 0444 {} +

USER 101:101
EXPOSE 8443
STOPSIGNAL SIGQUIT
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -T 4 -O /dev/null http://127.0.0.1:8080/__edge/live || exit 1
ENTRYPOINT ["/usr/local/bin/numismat-web-entrypoint"]
